rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lobbies are public to signed-in players; only the API writes them.
    match /lobbies/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Full game state is server-only (it contains fogged pieces).
    match /games/{id} {
      allow read, write: if false;
      // Each player may read only their own fog-filtered view.
      match /views/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
